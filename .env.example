# Supabase
# Get these from your Supabase project at https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your-key

# Database (Supabase Postgres)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Google OAuth
# Configure at: https://console.cloud.google.com → APIs & Services → Credentials
# Also enable in Supabase: Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sanity CMS (optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your-api-token
