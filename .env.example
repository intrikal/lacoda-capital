# ============================================================================
# Lacoda Capital — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# Full setup guides: docs/integrations/README.md
# ============================================================================

# ─── Supabase (REQUIRED) ────────────────────────────────────────────────────
# Setup guide: docs/integrations/supabase-setup.md
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your-key

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
# Setup guide: docs/integrations/supabase-setup.md
# Get these from: https://supabase.com/dashboard → Project Settings → Database
# DATABASE_URL uses port 6543 (transaction pooler) — for app queries
# DIRECT_URL uses port 5432 (direct connection) — for migrations
DATABASE_URL=postgresql://postgres.your-project-ref:[password]@aws-1-us-east-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.your-project-ref:[password]@aws-1-us-east-2.pooler.supabase.com:5432/postgres

# ─── Site URL (REQUIRED) ────────────────────────────────────────────────────
# Used for OAuth redirects, email links, and callback URLs
# Change to your production domain when deploying
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Google OAuth (REQUIRED for Google sign-in) ─────────────────────────────
# Setup guide: docs/integrations/google-oauth-setup.md
# Get these from: https://console.cloud.google.com → APIs & Services → Credentials
# Also enable in Supabase: Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft / Azure OAuth (optional — for "Continue with Microsoft") ─────
# Setup guide: docs/integrations/microsoft-oauth-setup.md
# Get these from: https://portal.azure.com → App registrations
# Also enable in Supabase: Authentication → Providers → Azure
# Note: These are stored here for reference. The OAuth flow is handled by Supabase.
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ─── Stripe Payments (optional — required for billing/payment collection) ─────
# Setup guide: docs/integrations/stripe-setup.md
# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Plaid Financial Data (optional — auto-sync bank balances & holdings) ─────
# Setup guide: docs/integrations/plaid-setup.md
# Get these from: https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# PLAID_WEBHOOK_SECRET=

# ─── DocuSign E-Signatures (optional — send documents for signing) ────────────
# Setup guide: docs/integrations/docusign-setup.md
# Get these from: https://admindemo.docusign.com/apps-and-keys
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net
# DOCUSIGN_WEBHOOK_SECRET=

# ─── QuickBooks Accounting (optional — sync invoices to QuickBooks) ───────────
# Setup guide: docs/integrations/quickbooks-setup.md
# Get these from: https://developer.intuit.com/app/developer/dashboard
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox

# ─── Salesforce CRM (optional — bi-directional client & deal sync) ───────────
# Setup guide: docs/integrations/salesforce-setup.md
# Get these from: https://login.salesforce.com → Setup → App Manager → New Connected App
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# ─── Google Drive (optional — import documents from Drive) ────────────────────
# Setup guide: docs/integrations/google-drive-setup.md
# Uses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from above
# Just enable the Google Drive API in your Google Cloud project

# ─── Resend Email (optional — required for transactional emails) ─────────────
# Setup guide: docs/integrations/resend-setup.md
# NOTE: The Resend API key is stored as a Supabase Edge Function secret,
# NOT in this file. Set it with: npx supabase secrets set RESEND_API_KEY=re_xxx
# Get your key from: https://resend.com/api-keys

# ─── Sentry (optional — app works without it, just no error reporting) ───────
# Setup guide: docs/integrations/sentry-setup.md
# Get these from: https://sentry.io → Project Settings
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── PostHog (optional — app works without it, just no analytics) ────────────
# Setup guide: docs/integrations/posthog-setup.md
# Get these from: https://app.posthog.com → Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Sanity CMS (optional — for marketing site content) ─────────────────────
# Setup guide: docs/integrations/sanity-setup.md
# Get these from: https://www.sanity.io/manage → Your Project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# ─── Logging ─────────────────────────────────────────────────────────────────
# Pino log level. Options: trace, debug, info, warn, error, fatal
# LOG_LEVEL=debug
